{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,

    // A composite project must emit, so `tsc -b` was writing vite.config.js,
    // vite.config.d.ts and the .tsbuildinfo files straight into the source tree
    // on every build. Redirect all of it somewhere already ignored.
    "outDir": "./node_modules/.tmp/tsconfig.node",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite.config.ts"]
}
