{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "comment": "SPA fallback: /transactions, /connectors/callback and friends are client-side routes.",
      "source": "/((?!assets/|config\.js).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "comment": "config.js carries runtime API URLs and must never be cached.",
      "source": "/config.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "comment": "Hashed asset filenames are immutable.",
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
