# --- Secrets ---
.env
*.env.local

# --- Java / Maven (core-api) ---
core-api/target/
*.class
*.jar
!maven-wrapper.jar
.mvn/wrapper/maven-wrapper.properties

# --- Python (analytics-service) ---
analytics-service/__pycache__/
analytics-service/**/__pycache__/
analytics-service/.pytest_cache/
analytics-service/venv/
analytics-service/.venv/
*.pyc

# --- Node / frontend ---
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
# Safety net: tsconfig*.json redirect these into node_modules/.tmp, but a stale
# checkout or a changed config must not slip build output into the repo.
*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts

# --- IDE ---
.idea/
.vscode/
*.iml

# --- OS ---
.DS_Store
Thumbs.db

# --- Docker ---
docker-compose.override.yml

# --- Generated sample data (recreate with scripts/make-sample-data.py) ---
sample-transactions.csv

# --- Logs ---
*.log
