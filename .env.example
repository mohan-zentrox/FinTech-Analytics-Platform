# Copy to .env and fill in real values before running docker-compose or any
# service locally. Never commit a real .env file (see .gitignore).

# --- PostgreSQL (shared by core-api and analytics-service) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ledger
DB_USER=ledger_app
DB_PASSWORD=change-me-ledger-app-password
# Optional: a full JDBC URL wins over DB_HOST/DB_PORT/DB_NAME. Handy for managed
# Postgres that requires TLS, e.g.
# DATABASE_URL=jdbc:postgresql://ep-x.eu-central-1.aws.neon.tech/ledger?sslmode=require
# DATABASE_URL=
DB_POOL_MAX=5

# --- core-api (Spring Boot) ---
SERVER_PORT=8080
# HS256 key, must be >= 32 bytes. Generate with: openssl rand -base64 48
# analytics-service verifies tokens with this SAME value - keep them in sync.
JWT_SECRET=change-this-to-a-long-random-base64-string-before-deploying
JWT_EXPIRATION_MS=3600000

# --- analytics-service (FastAPI) - dedicated READ-ONLY Postgres role ---
# core-api's V2__analytics_readonly_role.sql migration creates/updates the
# ledger_readonly role using ANALYTICS_DB_PASSWORD, so this one value configures
# both sides. If your Postgres forbids CREATE ROLE (some managed free tiers do),
# the migration logs a NOTICE and you should point these at provider-issued
# read-only credentials instead.
ANALYTICS_DB_USER=ledger_readonly
ANALYTICS_DB_PASSWORD=change-me-ledger-readonly-password
ANALYTICS_SERVICE_PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:5173
# Set to false only for local debugging - it disables JWT checks on /analytics/**.
ANALYTICS_REQUIRE_AUTH=true

# --- Anomaly / fraud detection (FRD S5.4) ---
FRAUD_LOOKBACK_DAYS=90
FRAUD_DUPLICATE_WINDOW_DAYS=7
FRAUD_OUTLIER_Z_THRESHOLD=3.0
FRAUD_OUTLIER_MIN_SAMPLE=8
FRAUD_VELOCITY_Z_THRESHOLD=3.0
FRAUD_VELOCITY_MIN_DAILY_COUNT=5
FRAUD_ROUND_AMOUNT_MULTIPLE=1000
FRAUD_ROUND_AMOUNT_FLOOR=10000
FRAUD_AUTO_FLAG=false

# --- Scheduled reporting (FRD S6.1) ---
# Leave disabled on scale-to-zero hosting (Render free, Cloud Run): a sleeping
# container cannot fire a cron trigger. Use an external scheduler to POST
# /api/reports/generate instead.
REPORTS_SCHEDULE_ENABLED=false
REPORTS_CRON=0 0 2 1 * *
REPORTS_TZ=UTC
REPORTS_DEFAULT_FORMAT=PDF
REPORTS_RETENTION_DAYS=365

# --- Accounting connectors (FRD S6.2) ---
# AES-256-GCM key encrypting stored OAuth tokens: openssl rand -base64 32
CONNECTOR_ENCRYPTION_KEY=local-dev-only-connector-key-0123456789abcdef
# true = simulate the OAuth handshake and sync locally (no developer account
# needed). Set false and fill in the client id/secret pairs to go live.
CONNECTORS_SANDBOX=true
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://localhost:5173/connectors/callback
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:5173/connectors/callback
NETSUITE_CLIENT_ID=
NETSUITE_CLIENT_SECRET=
NETSUITE_REDIRECT_URI=http://localhost:5173/connectors/callback

# --- frontend (Vite) ---
VITE_CORE_API_BASE_URL=http://localhost:8080/api
VITE_ANALYTICS_API_BASE_URL=http://localhost:8000/analytics
